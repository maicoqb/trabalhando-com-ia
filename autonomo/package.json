{
  "name": "mcp-memorias",
  "version": "1.0.0",
  "description": "MCP de memórias — coleta memórias cruas e as materializa na Wiki do Maico via LLM-curador",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:server": "node --loader tsx src/server.ts",
    "dev:worker": "node --loader tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.19.1",
    "better-sqlite3": "11.10.0",
    "express": "4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "typescript": "5.7.3"
  }
}
